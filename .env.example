# ── API Keys ──────────────────────────────────────

# Anthropic (Claude — cloud LLM fallback)
ANTHROPIC_API_KEY=sk-your-anthropic-key-here

# Reddit (PRAW — optional, JSON API works without auth)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=talentsia-scraper/1.0

# X / Twitter (v2 API — optional)
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# Instagram Graph API
IG_ACCESS_TOKEN=your-instagram-long-lived-token
IG_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id

# Telegram Bot (previews + notifications)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ── Local AI Models ──────────────────────────────

# Ollama (LLM server)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral-ft
OLLAMA_MODEL_FALLBACK=llama3.1:8b

# ComfyUI (FLUX.1 Schnell image generation)
COMFYUI_API_URL=http://localhost:8188

# CogVideoX (text-to-video B-roll)
COGVIDEO_API_URL=http://localhost:8100

# Wan2.1 (alternative video model — set VIDEO_MODEL=wan21 to use)
WAN21_API_URL=http://localhost:8200
VIDEO_MODEL=cogvideox

# ── Voice & Avatar ───────────────────────────────

# XTTS-v2 (voice synthesis)
XTTS_API_URL=http://localhost:8020
REFERENCE_AUDIO_PATH=./assets/voice_sample.wav

# Lip Sync Model: "sadtalker" or "latentsync"
LIP_SYNC_MODEL=sadtalker
SADTALKER_API_URL=http://localhost:8030
LATENTSYNC_API_URL=http://localhost:8040

# Avatar photo for lip sync
AVATAR_PHOTO_PATH=./assets/avatar_photo.png

# Whisper (auto-captions)
WHISPER_API_URL=http://localhost:9000

# ── Ranker ───────────────────────────────────────

# Embedding model for semantic ranking (sentence-transformers)
RANKER_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Infrastructure ───────────────────────────────

# Redis (Celery message broker)
REDIS_URL=redis://localhost:6379/0

# Output directory
OUTPUT_DIR=./output

# Debug mode
DEBUG=false
